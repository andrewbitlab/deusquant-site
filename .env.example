# Database Configuration
# Get free PostgreSQL database from:
# - Neon: https://neon.tech (recommended - serverless, fastest)
# - Supabase: https://supabase.com
# - Railway: https://railway.app

# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Application
NEXT_PUBLIC_APP_NAME="DEUS QUANT Portfolio"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Production (Netlify)
# Add DATABASE_URL to Netlify environment variables:
# 1. Go to: https://app.netlify.com/sites/deusquant/configuration/env
# 2. Add key: DATABASE_URL
# 3. Add value: your connection string
# 4. Redeploy
