generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id         String   @id
  action     String
  entityType String
  entityId   String
  changes    String?
  userId     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Portfolio {
  id                String              @id
  name              String
  description       String?
  rebalanceFreq     String?             @default("MONTHLY")
  weightMethod      String              @default("INVERSE_DD")
  equityCurve       String?
  statistics        String?
  lastCalculated    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  createdBy         String?
  isPublic          Boolean             @default(false)
  PortfolioStrategy PortfolioStrategy[]

  @@index([isPublic])
}

model PortfolioStrategy {
  id           String    @id
  portfolioId  String
  strategyId   String
  weight       Float
  customWeight Float?
  enabled      Boolean   @default(true)
  addedAt      DateTime  @default(now())
  Portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  Strategy     Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, strategyId])
  @@index([enabled])
}

model Strategy {
  id                String              @id
  magicNumber       Int                 @unique
  name              String
  symbol            String
  timeframe         String
  version           String?             @default("1.0.0")
  backtestStart     DateTime
  backtestEnd       DateTime
  forwardStart      DateTime?
  forwardEnd        DateTime?
  backtestMetrics   String
  forwardMetrics    String?
  combinedMetrics   String?
  backtestEquity    String
  forwardEquity     String?
  combinedEquity    String?
  monthlyReturns    String?
  status            String              @default("BACKTEST")
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  createdBy         String?
  PortfolioStrategy PortfolioStrategy[]
  Transaction       Transaction[]

  @@index([status, isActive])
  @@index([symbol, timeframe])
}

model Transaction {
  id            String    @id
  strategyId    String
  orderId       Int
  type          String
  symbol        String
  volume        Float
  openPrice     Float
  closePrice    Float?
  sl            Float?
  tp            Float?
  openTime      DateTime
  closeTime     DateTime?
  commission    Float
  swap          Float
  profit        Float
  balance       Float?
  comment       String?
  isForwardTest Boolean   @default(false)
  createdAt     DateTime  @default(now())
  Strategy      Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, openTime])
  @@index([strategyId, orderId])
  @@index([symbol])
}
